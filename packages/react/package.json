{
  "name": "@mitumba/logistics-react",
  "version": "0.1.0",
  "description": "React views for Mitumba Logistics — embedded delivery quote, method picker, and parcel tracking over @mitumba/logistics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mitumba-Ltd/mitumba-logistics.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/Mitumba-Ltd/mitumba-logistics/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/Mitumba-Ltd/mitumba-logistics/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react,react-dom",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --environment jsdom --maxWorkers=1 --minWorkers=1",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@mitumba/logistics": "0.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "jsdom": "26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "vitest": "^2.1.1"
  }
}
